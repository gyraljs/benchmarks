{
  "name": "gyral-benchmarks",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sizes": "node scripts/sizes.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm build && pnpm test",
    "bench": "node scripts/bench.mjs",
    "report": "node scripts/report.mjs",
    "validate:timing": "node scripts/validate-timing.mjs"
  },
  "devDependencies": {
    "@bench/shared": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "pnpm": {
    "overrides": {
      "lit-html": "3.3.0",
      "@gyral/core": "0.2.0",
      "@gyral/time": "0.2.0",
      "two-track": "file:vendor-twotrack-v2/two-track-0.1.0.tgz",
      "pipewise": "file:vendor-pipewise-v2/pipewise-1.0.0.tgz",
      "@bench/gyral-next>@gyral/core": "file:vendor-next/gyral-core-next.tgz",
      "@bench/gyral-next>@gyral/time": "file:vendor-next/gyral-time-next.tgz",
      "@gyral/time@0.3.0>@gyral/core": "file:vendor-next/gyral-core-next.tgz"
    }
  }
}
